<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haiku 575</title>
    <link rel="stylesheet" href="/index.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Roboto:ital,wght@0,100..900;1,100..900&family=VT323&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body>
    <header>
        <h1 class="siteTitle" aria-label="Haiku 575">
            <span class="word">
                <span class="letter" aria-hidden="true">H</span><span class="letter" aria-hidden="true">A</span><span class="letter" aria-hidden="true">I</span><span class="letter" aria-hidden="true">K</span><span class="letter" aria-hidden="true">U</span>
            </span>
            <span class="word">
                <span class="letter" aria-hidden="true">5</span><span class="letter" aria-hidden="true">7</span><span class="letter" aria-hidden="true">5</span>
            </span>
        </h1>
        <p class="tagline">Write, discover, and generate haikus.</p>
    </header>

    <div id="successPopup" class="popup">
        <span>Haiku submitted!</span>
        <button id="popupClose" type="button" aria-label="Close">&times;</button>
    </div>

    <div id="confirmModal" class="modalOverlay hidden">
        <div class="modalBox">
            <p id="confirmMessage"></p>
            <span>
                <button id="confirmYesButton" type="button" class="destructive">YES</button>
                <button id="confirmNoButton" type="button">CANCEL</button>
            </span>
        </div>
    </div>

    <main>

        <div class="section">
            <details>
                <summary> What is a Haiku? </summary>
                <p class="bullet-line">&nbsp;&nbsp;&#8226; A Haiku is three-line poem in a 5-7-5 syllable structure.</p>
                <p>&nbsp; Example:</p>
                <p class="bullet-line">&nbsp;&nbsp;&#8226; The sun is overhead (5)</p>
                <p class="bullet-line">&nbsp;&nbsp;&#8226; Laziness blisters the skin (7)</p>
                <p class="bullet-line">&nbsp;&nbsp;&#8226; Next time wear a shirt (5)</p>

            </details>
            <details>
                <summary> Haiku Tips</summary>
                <p class="bullet-line-sm">&nbsp;&#8226; Haikus do not typically use rhyming words</p>
                <p class="bullet-line-sm">&nbsp;&#8226; Classic Haikus focus on nature or sensory observations</p>
                <p class="bullet-line-sm">&nbsp;&#8226; Traditionally haikus feature a 'cutting word' that divides the poem into two distinct ideas</p>
            </details>
        </div>

        <div class="section">
            <form id="haikuForm" action="/submit" method="POST">

                <!-- % indicates raw js via ejs -->
                <div id="formErrors" class="<%= errors.length ? 'has-errors' : '' %>">
                    <% errors.forEach(error => { %>
                        <p class="notice"><%= error %></p>
                    <%}) %>
                </div>
                <fieldset>
                    <button id="writeSpeakerButton" type="button" class="speakerButton" aria-label="Read haiku aloud">
                        <%- include('partials/speaker-icon') %>
                    </button>
                    <legend> Write A Haiku</legend>

                        <textarea id="firstLine"  placeholder="Write some words in" spellcheck="true" name="lineOne"></textarea>
                        <span class="lineCheck" id="firstLineCount">0/5</span>

                        <textarea id="secondLine" placeholder="These spaces to create your" spellcheck="true" name="lineTwo"></textarea>
                        <span class="lineCheck" id="secondLineCount">0/7</span>

                        <textarea id="thirdLine" placeholder="Very own haiku poem" spellcheck="true" name="lineThree"></textarea>
                        <span class="lineCheck" id="thirdLineCount">0/5</span>

                        <textarea id="authorName" placeholder="author name" name="authorName"></textarea>

                    <span>
                        <button id="submitButton">
                            SUBMIT
                        </button>

                        <button id ="clearButton" type="reset">
                            CLEAR
                        </button>
                    </span>
                </fieldset>
            </form>

        </div>

        <div class="section" id="loadSection">
            <fieldset>
                <button id="loadSpeakerButton" type="button" class="speakerButton" aria-label="Read haiku aloud">
                    <%- include('partials/speaker-icon') %>
                </button>
                <legend>Load A Haiku</legend>
                <div id="loadErrors"></div>
                <blockquote id="loadHaiku" class="haikuDisplay hidden" data-haiku-id="">
                    <p class="haikuLine" id="loadLineOne"></p>
                    <p class="haikuLine" id="loadLineTwo"></p>
                    <p class="haikuLine" id="loadLineThree"></p>
                    <footer>&mdash; <cite id="loadAuthor"></cite></footer>
                </blockquote>
                <span>
                    <button id="loadButton">
                    LOAD
                    </button>
                </span>

                <button id="deleteButton" type="button" class="hidden deleteButton destructive">
                DELETE
                </button>
            </fieldset>
        </div>

        <div class="section" id="generateSection">
            <fieldset>
                <button id="generateSpeakerButton" type="button" class="speakerButton" aria-label="Read haiku aloud">
                    <%- include('partials/speaker-icon') %>
                </button>
                <legend>Generate A Haiku</legend>
                <div id="generateErrors"></div>
                <blockquote id="generatedHaiku" class="haikuDisplay hidden">
                    <p class="haikuLine" id="generateLineOne"></p>
                    <p class="haikuLine" id="generateLineTwo"></p>
                    <p class="haikuLine" id="generateLineThree"></p>
                </blockquote>
                <span>
                    <button id="generateButton">
                    GENERATE
                    </button>
                </span>
            </fieldset>
        </div>
    </main>
<script type="module" src="/main.js"></script>
</body>
</html>
