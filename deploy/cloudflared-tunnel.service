[Unit]
Description=Cloudflare Quick Tunnel for haiku575
After=network-online.target haiku575.service
Wants=network-online.target

[Service]
Type=simple

# EDIT: must match the user whose ~/.msmtprc holds the mail credentials,
# and whose $HOME the wrapper script writes its log file under.
User=pi

ExecStart=/usr/local/bin/haiku-tunnel.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
