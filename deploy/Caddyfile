# Replace yourdomain.com with your actual domain, then drop this into
# /etc/caddy/Caddyfile on the Pi. Caddy handles Let's Encrypt HTTPS
# automatically - no certbot, no manual renewal.
#
# If you're using Cloudflare Tunnel instead of port-forwarding, you likely
# don't need this file at all - point the tunnel's public hostname straight
# at http://localhost:3000 and skip Caddy entirely.

yourdomain.com {
    reverse_proxy 127.0.0.1:3000
}
